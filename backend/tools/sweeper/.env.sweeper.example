# ═══════════════════════════════════════════════════════════════
#   NEXUS GATEWAY — STANDALONE SWEEPER CONFIGURATION
#   Copy this file to .env.sweeper and fill in your values.
#   NEVER commit .env.sweeper to Git.
# ═══════════════════════════════════════════════════════════════

# ─── REQUIRED: HD Wallet ───────────────────────────────────────
# Your 12 or 24-word BIP-39 mnemonic (the same one in Render)
HD_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon"

# ─── REQUIRED: Cold Wallet Destinations ───────────────────────
# Funds will be forwarded TO these addresses after sweep
BSC_COLD_WALLET=0x943c7eb933fa9724433095973a03f5a880976d2a
TRON_COLD_WALLET=TS2rMsBFtWM8VV3qN6PuHEmNdsbo3BQj4K

# ─── OPTIONAL: Gas Station Hot Wallets ────────────────────────
# These wallets fund deposit addresses with BNB/TRX before sweep.
# If omitted, the deposit address must already hold gas.
# ⚠ Keep these private keys secure — they hold real BNB/TRX.
GAS_STATION_BSC_PRIVKEY=0x55d398326f99059fF775485246999027B3197955
GAS_STATION_TRON_PRIVKEY=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ─── OPTIONAL: Custom RPC Nodes ───────────────────────────────
# Defaults shown below. Override if you have a private RPC.
BSC_RPC=https://bsc-dataseed.binance.org
TRON_FULL_NODE=https://api.trongrid.io
