# ═══════════════════════════════════════════════════════════════
#   NEXUS GATEWAY — ENTERPRISE STANDALONE AUTO-SWEEPER CONFIG
#   Copy this file to .env.sweeper and fill in your values.
#   NEVER commit .env.sweeper to Git.
# ═══════════════════════════════════════════════════════════════

# ─── REQUIRED: HD Wallet ───────────────────────────────────────
# Your 12 or 24-word BIP-39 mnemonic phrase (same as gateway backend)
HD_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# ─── REQUIRED: Cold Storage Destination Wallets ────────────────
# 100% of swept funds will be forwarded TO these addresses
BSC_COLD_WALLET=0x943c7eb933fa9724433095973a03f5a880976d2a
TRON_COLD_WALLET=TS2rMsBFtWM8VV3qN6PuHEmNdsbo3BQj4K

# ─── OPTIONAL: Gas Station Hot Wallets (For --live Mode) ───────
# These hot wallets fund derived deposit addresses with BNB/TRX before sweep.
# Required ONLY when executing real sweeps on addresses with 0 gas balance.
# ⚠️ Put valid private keys here (NOT public addresses or contract addresses).
GAS_STATION_BSC_PRIVKEY=
GAS_STATION_TRON_PRIVKEY=

# ─── OPTIONAL: Multi-Source RPC & Indexer Configuration ────────
# High-reliability primary endpoints. Multi-node failover pool is built-in.
BSC_RPC=https://bsc-dataseed1.defibit.io
TRON_FULL_NODE=https://api.trongrid.io
TRON_API_KEY=

# ─── OPTIONAL: Database Cross-Verification & Sync ─────────────
# If provided, the sweeper aggregates and cross-references addresses
# against MongoDB invoices, verifying expected vs paid amounts.
# In --live mode with --sync-db, it updates invoice status to FORWARDED.
MONGODB_URI=

# ─── OPTIONAL: Operational Thresholds ──────────────────────────
# Minimum USDT balance required to trigger a sweep (default: 0.50 USD)
MIN_SWEEP_USD=0.5

# Parallel address audit batch size (default: 5)
SCAN_CONCURRENCY=5
