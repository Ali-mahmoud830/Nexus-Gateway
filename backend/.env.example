# ============================================================
# CRYPTO PAYMENT GATEWAY — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and fill in ALL values.
# The real .env is git-ignored and MUST NEVER be committed.
# In production, load these from a secrets manager.
# ============================================================

# ---- Server ------------------------------------------------
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ---- CORS --------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- MongoDB -----------------------------------------------
# Use a dedicated read/write user with least-privilege access.
# Direct replica-set URI (Atlas SRV resolution may be unavailable on some machines).
MONGODB_URI=mongodb://DB_USER:DB_PASS@shard-00.mongodb.net:27017,shard-01.mongodb.net:27017,shard-02.mongodb.net:27017/crypto_gateway?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
MONGODB_DB_NAME=crypto_gateway

# ---- JWT Auth (for internal API calls) ---------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_EXPIRES_IN=1h

# ---- HD Wallet (Master Mnemonic) ---------------------------
# !!! HIGHEST SENSITIVITY — treat exactly like your private key !!!
# Generate offline with: npx bip39 generate
# In production: load from a HSM or encrypted secrets manager.
# NEVER store the real mnemonic here or commit this file with a real value.
HD_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Derivation path bases (BIP-44 compatible)
BSC_DERIVATION_PATH=m/44'/60'/0'/0
TRON_DERIVATION_PATH=m/44'/195'/0'/0

# Advance this counter if you rotate keys to avoid address reuse
HD_ADDRESS_COUNTER_OFFSET=0

# ---- Cold / Main Wallet Addresses --------------------------
# DESTINATION addresses only — never store private keys here.
BSC_MAIN_WALLET=0xYOUR_BSC_COLD_WALLET_ADDRESS
TRON_MAIN_WALLET=TYOUR_TRON_COLD_WALLET_ADDRESS

# ---- BSC RPC Nodes (ordered by priority) -------------------
BSC_RPC_PRIMARY=https://bsc-rpc.publicnode.com
BSC_RPC_SECONDARY=https://bsc.drpc.org
BSC_RPC_TERTIARY=https://1rpc.io/bnb

BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_CONFIRMATIONS_REQUIRED=3

# ---- TRON RPC Nodes ----------------------------------------
TRON_FULL_NODE=https://api.trongrid.io
TRON_SOLIDITY_NODE=https://api.trongrid.io
TRON_EVENT_SERVER=https://api.trongrid.io
TRON_API_KEY=GET_FREE_KEY_AT_TRONGRID_IO

TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_CONFIRMATIONS_REQUIRED=20

# ---- Invoice Settings --------------------------------------
INVOICE_EXPIRY_MINUTES=15

# ---- Forwarding / Sweeper ----------------------------------
SWEEPER_CRON_INTERVAL_SECONDS=30
SWEEPER_MIN_AMOUNT_USD=1

# Optional: override Gas Station wallets (leave blank to auto-derive from HD mnemonic)
GAS_STATION_BSC_PRIVATE_KEY=
GAS_STATION_TRON_PRIVATE_KEY=

# ---- Logging -----------------------------------------------
LOG_LEVEL=debug
LOG_DIR=./logs
