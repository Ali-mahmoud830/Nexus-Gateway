# ============================================================
# NEXUS GATEWAY — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# This file defines the reference configuration for both local 
# development and production deployments (Render, Railway, VPS).
# ============================================================

# ---- Server Configuration ----------------------------------
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ---- CORS & Client Whitelist -------------------------------
ALLOWED_ORIGINS=https://nexus-gateway-vert.vercel.app,https://*.vercel.app,http://localhost:3000,http://localhost:3001

# ---- MongoDB Atlas Database --------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/crypto_gateway?retryWrites=true&w=majority
MONGODB_DB_NAME=crypto_gateway

# ---- Cryptographic JWT Auth & Webhooks ---------------------
JWT_SECRET=71b87c391e4d400416ebc7bb5220c44840e0837046c38437c313a951347cca984ec86abeb1b85f8affad63ed56ae7fea37b54277e077ed1756b85562d18f9287
JWT_EXPIRES_IN=30d

# ---- Master BIP-39 HD Mnemonic -----------------------------
# ⚠️ Secure 12-word seed phrase (NEVER use "abandon abandon..." in production):
HD_MNEMONIC=wreck skull custom borrow girl senior coach bomb hammer similar pull scrap

# Derivation path bases (Standard BIP-44)
BSC_DERIVATION_PATH=m/44'/60'/0'/0
TRON_DERIVATION_PATH=m/44'/195'/0'/0
HD_ADDRESS_COUNTER_OFFSET=0

# ---- Primary Cold Storage Destination Wallets --------------
# 100% of swept deposits will be forwarded TO these addresses:
BSC_MAIN_WALLET=0x943c7eb933fa9724433095973a03f5a880976d2a
TRON_MAIN_WALLET=TS2rMsBFtWM8VV3qN6PuHEmNdsbo3BQj4K

# ---- Binance Smart Chain (BSC / BEP-20) --------------------
BSC_RPC_PRIMARY=https://bsc-dataseed.binance.org
BSC_RPC_SECONDARY=https://bsc-dataseed1.defibit.io
BSC_RPC_TERTIARY=https://bsc-rpc.publicnode.com
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_CONFIRMATIONS_REQUIRED=3

# ---- TRON Network (TRC-20) ---------------------------------
TRON_FULL_NODE=https://api.trongrid.io
TRON_SOLIDITY_NODE=https://api.trongrid.io
TRON_EVENT_SERVER=https://api.trongrid.io
TRON_API_KEY=
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_CONFIRMATIONS_REQUIRED=20

# ---- Invoice Life-Cycle & Sweeper Worker -------------------
INVOICE_EXPIRY_MINUTES=15
SWEEPER_CRON_INTERVAL_SECONDS=30
SWEEPER_MIN_AMOUNT_USD=1

# ---- Gas Station Hot Wallets (Optional Overrides) ----------
# Leave blank to automatically derive internal gas wallets from HD_MNEMONIC:
GAS_STATION_BSC_PRIVATE_KEY=
GAS_STATION_TRON_PRIVATE_KEY=

# ---- Operational Logging -----------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
