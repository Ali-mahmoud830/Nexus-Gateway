    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "mongoose": "^8.0.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "uuid": "^9.0.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "http-status-codes": "^2.3.0",
    "web3": "^4.3.2",
    "ethers": "^6.9.2",
    "tronweb": "^5.3.2",
    "bip39": "^3.1.0",
    "hdkey": "^2.1.0",
    "node-cron": "^3.0.3",
    "ws": "^8.16.0",
    "axios": "^1.6.5",
